# ============================================================
#  POC Agent IA - Ouvertures d'échecs (P13)
#  Copiez ce fichier en « .env » et renseignez les valeurs.
#      cp .env.example .env
# ============================================================

# --- Backend --------------------------------------------------
# Port exposé du backend FastAPI (host:conteneur)
BACKEND_PORT=9000

# --- Clés API externes (à obtenir, voir README) ---------------
# Jeton Lichess (aucun scope requis) : https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=

# Clé YouTube Data API v3 : https://console.cloud.google.com
YOUTUBE_API_KEY=

# --- LLM (serveur GPU PGX via tunnel SSH) ---------------------
# Modèle génératif servi par Ollama sur la PGX
OLLAMA_MODEL=qwen3-vl:30b-a3b-instruct-q8_0
# URL d'Ollama vue depuis le conteneur backend (via le tunnel).
# Laisser la valeur par défaut sauf changement d'architecture.
# OLLAMA_BASE_URL=http://ollama-tunnel:11434

# --- Tunnel SSH vers la PGX -----------------------------------
# Dossier CONTENANT la clé privée « id_ed25519_ollama » et « known_hosts »
# (hors du dépôt Git). Adapter au chemin réel de la machine hôte.
SSH_DIR=C:/Users/%USERNAME%/.ssh

# --- Embeddings (modèle local, dans le conteneur backend) -----
# Valeurs par défaut définies dans le code ; ne renseigner que pour override.
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Milvus (base vectorielle, valeurs par défaut) ------------
# MILVUS_URI=http://milvus:19530
# MILVUS_COLLECTION=wikichess
# EMBEDDING_DIM=1024

APP_NAME=Agent IA Ouvertures Échecs - API
